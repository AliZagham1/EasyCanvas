# Copy this file to .env in the repository root, then replace these placeholders.
CANVAS_URL=https://your-canvas-host.example
CANVAS_TOKEN=replace_with_your_own_canvas_token

# Optional: required for embedding indexing, semantic search, and RAG answers.
OPENAI_API_KEY=replace_with_your_own_openai_api_key
# Optional: answer model only; does not change the embedding model/cache.
EASYCANVAS_ANSWER_MODEL=gpt-6-luna

# Optional: explicitly select one of your own Canvas enrollment terms.
# Leave blank to select active student courses whose term dates include today.
CANVAS_TERM_ID=

# Optional: background sync interval in seconds (minimum 60).
COURSE_SYNC_INTERVAL_SECONDS=1800

# Optional: full path to your own LibreOffice executable if it is not on PATH.
LIBREOFFICE_PATH=

# Optional: model used only for conversational follow-up query understanding.
EASYCANVAS_QUERY_MODEL=gpt-6-luna

# Paid visual document extraction during ingestion (never during chat).
# Requires OPENAI_API_KEY. Set false to inspect without paid visual processing.
EASYCANVAS_VISION_ENABLED=true
EASYCANVAS_VISION_MODEL=gpt-6-luna
